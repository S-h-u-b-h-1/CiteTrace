# Leave the key empty for a local preview with no Flagsmith traffic.
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_FLAG_NAME=citation_opening
# For cloud, use the defaults. For self-hosting, set these two URLs.
# FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# FLAGSMITH_EVENTS_URL=http://localhost:8000/api/
CITETRACE_TRAFFIC=pilot
# Use a different database and Flagsmith environment for synthetic traffic.
# CITETRACE_DB=.citetrace/reviews.sqlite
# Optional, read a held-out review task from a private absolute file path.
# CITETRACE_TASK_FILE=/path/outside/public/citetrace-held-out-task.json
# Required when using a held-out task with Flagsmith. Use a fresh pilot experiment.
# CITETRACE_EXPERIMENT_ID=123
# Optional paired enrollment bounds for a held-out Flagsmith pilot (UTC).
# CITETRACE_PILOT_START_UTC=2026-11-27T10:00:00Z
# CITETRACE_PILOT_END_UTC=2026-11-28T10:00:00Z
# Optional, preview only. full_source or focused_source.
# CITETRACE_PREVIEW_VARIANT=focused_source
# Set true when serving browsers over HTTPS.
# CITETRACE_SECURE_COOKIE=true
HOST=127.0.0.1
PORT=3000
